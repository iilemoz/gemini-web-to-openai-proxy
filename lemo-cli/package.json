{
  "name": "lemo-cli",
  "version": "0.1.0",
  "description": "Lemo CLI — Standalone Terminal AI Assistant and Autonomous Coding Agent",
  "main": "dist/cli/index.js",
  "bin": {
    "lemo": "./bin/lemo.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true});\"",
    "start": "node bin/lemo.js",
    "test": "npm run build && node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "chat",
    "coding-agent",
    "terminal",
    "lemo"
  ],
  "author": "Lemo",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
