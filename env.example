PORT=3000
HOST=0.0.0.0
DEFAULT_MODEL=gemini-flash

# Google Gemini Credentials:
# Leave GEMINI_SECURE_1PSID empty for Guest Mode (No login required)
# Or enter your __Secure-1PSID cookie value from gemini.google.com for Account Mode
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Proxy Security:
# Secret API key required to access the proxy (Bearer token in client requests)
# Leave empty for local development mode
PROXY_API_KEY=

# Optional Security and Gateway Settings:
ALLOW_COOKIE_PASSTHROUGH=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=*

# Optional Outbound Proxy for regions where Gemini is restricted:
# HTTPS_PROXY=http://127.0.0.1:7890
