# ==============================================================================
# Google Gemini Web to OpenAI Proxy — Unified Environment Configuration Template
# ==============================================================================
# Supports both:
#   Profile A: Local Windows Workstation (Direct Node.js / IDE Integration)
#   Profile B: VPS / Cloud Production (Behind Reverse Proxy / Nginx / Caddy)
#
# Instructions:
# 1. Copy this file to `.env`:
#    - Windows (PowerShell): Copy-Item .env.example .env
#    - Linux (Bash): cp .env.example .env
# 2. Configure the required settings for your chosen deployment profile below.
# 3. NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Network Binding
# ------------------------------------------------------------------------------
# Runtime environment: 'development' (default) or 'production'
# - Profile A (Local): development
# - Profile B (VPS): production (enforces PROXY_API_KEY >= 16 chars)
NODE_ENV=development

# Port to bind HTTP service (1-65535, default: 3000)
PORT=3000

# Network host binding:
# - Profile A (Local): 127.0.0.1 (bind to local loopback only)
# - Profile B (VPS): 127.0.0.1 (recommended behind local reverse proxy) or 0.0.0.0
HOST=127.0.0.1

# Default canonical model alias ('gemini-flash', 'gemini-pro', 'gemini-thinking', 'gemini-lite')
DEFAULT_MODEL=gemini-flash

# ------------------------------------------------------------------------------
# 2. Proxy Authentication & Gateway Security
# ------------------------------------------------------------------------------
# Secret API key required by clients to access this proxy (passed as Bearer token or x-api-key)
# - Profile A (Local): Optional in development mode. If empty, local requests proceed without auth.
# - Profile B (VPS): MANDATORY in production mode (must be at least 16 characters).
PROXY_API_KEY=your_strong_random_proxy_api_key_min_16_chars

# Allow client-provided Google cookies in request headers / Bearer token (default: false)
ALLOW_COOKIE_PASSTHROUGH=false

# ------------------------------------------------------------------------------
# 3. Google Gemini Web Credentials (Account Mode)
# ------------------------------------------------------------------------------
# Required for Account Mode. Obtain from browser session cookies at https://gemini.google.com
# - GEMINI_SECURE_1PSID: __Secure-1PSID cookie (starts with 'g.a.' or alphanumeric session token)
# - GEMINI_SECURE_1PSIDTS: __Secure-1PSIDTS cookie (starts with 'sidts-')
# - GEMINI_SECURE_1PSIDCC: __Secure-1PSIDCC cookie (starts with 'APD_')
# If left empty, the application attempts Guest Mode (subject to Google rate limits / bot challenges).
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=
GEMINI_SECURE_1PSIDCC=

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# - Profile A (Local / Dev): Defaults to '*' if unset (enables IDE & dev tooling).
# - Profile B (VPS / Prod): Set explicit allowed origins (e.g. 'https://app.example.com,https://ide.example.com').
#   If unset in production, cross-origin browser requests are rejected; non-browser IDE clients remain allowed.
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 5. Rate Limiting (In-Memory Sliding Window)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 6. Reliability, Timeouts & Lifecycle
# ------------------------------------------------------------------------------
# Upstream connection timeout in milliseconds (default: 15000 = 15s)
UPSTREAM_CONNECT_TIMEOUT_MS=15000

# Total request timeout in milliseconds (default: 120000 = 2m)
REQUEST_TIMEOUT_MS=120000

# SSE Streaming idle heartbeat timeout in milliseconds (default: 60000 = 1m)
STREAMING_IDLE_TIMEOUT_MS=60000

# Graceful shutdown draining period in milliseconds (default: 30000 = 30s)
SHUTDOWN_TIMEOUT_MS=30000

# Retry policy for upstream transient failures
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000
RETRY_JITTER=true

# ------------------------------------------------------------------------------
# 7. Optional Outbound Network Proxy & Diagnostics
# ------------------------------------------------------------------------------
# Outbound HTTP/HTTPS/SOCKS proxy for environments where direct connection to Google is restricted
# Examples: 'http://127.0.0.1:7890', 'socks5://127.0.0.1:1080'
# HTTPS_PROXY=
# HTTP_PROXY=

# Enable verbose diagnostic debug logging ('true' or 'false')
DEBUG=false
